# Dúnarà Marketplace — environment template (placeholders only)
# Copy to .env.local for development. On Vercel, set these in Project → Settings → Environment Variables.

NEXT_PUBLIC_APP_NAME="Dúnarà Marketplace"
# Production: https://your-app.vercel.app  |  Local: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifications (optional; core marketplace works without these) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_PROVIDER_NAME=
EMAIL_PROVIDER_DRY_RUN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
PUSH_PROVIDER_DRY_RUN=

# --- Optional multi-instance rate limiting (Upstash Redis REST) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
